# GroklyAI — Test Environment
# Validates production behaviour
# Uses promoted knowledge base — no regeneration

GROKLY_ENV=test
GROKLY_ENV_LABEL=Test

# Matches production pipeline behaviour
# quality_model on Sonnet not Opus
# because knowledge base is already promoted
GROKLY_ALIAS_QUALITY_MODEL=claude-sonnet-4-20250514
GROKLY_ALIAS_REASONING_MODEL=claude-sonnet-4-20250514
GROKLY_ALIAS_FAST_MODEL=claude-haiku-4-5-20251001
GROKLY_ALIAS_BALANCED_MODEL=claude-sonnet-4-20250514

# Use promoted knowledge base
GROKLY_KB_SOURCE=promoted
GROKLY_KB_PATH=./chroma_db_promoted

# Full ingestion allowed for re-promotion runs
GROKLY_INGEST_MAX_FUNCTIONS=9999
GROKLY_INGEST_MAX_DOCS=9999

# Auth on — validates user flows
GROKLY_AUTH_REQUIRED=true
GROKLY_ALLOW_SELF_SELECTION=true

GROKLY_DEBUG=false
