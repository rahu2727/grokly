# GroklyAI — Development Environment
# Fast and cheap — for building and testing locally

GROKLY_ENV=development
GROKLY_ENV_LABEL=Development

# All on Haiku for fast iteration
GROKLY_ALIAS_QUALITY_MODEL=claude-haiku-4-5-20251001
GROKLY_ALIAS_REASONING_MODEL=claude-haiku-4-5-20251001
GROKLY_ALIAS_FAST_MODEL=claude-haiku-4-5-20251001
GROKLY_ALIAS_BALANCED_MODEL=claude-haiku-4-5-20251001

# Limit ingestion scope
GROKLY_INGEST_MAX_FUNCTIONS=50
GROKLY_INGEST_MAX_DOCS=10
GROKLY_INGEST_MAX_IMAGES=5

# No auth for developer convenience
GROKLY_AUTH_REQUIRED=false
GROKLY_DEV_USER=chaudhary.rahul27@gmail.com
GROKLY_ALLOW_SELF_SELECTION=true

# Debug on
GROKLY_DEBUG=true
