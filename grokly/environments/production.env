# GroklyAI — Production Environment
# Full quality where it matters

GROKLY_ENV=production
GROKLY_ENV_LABEL=Production

# Opus for quality generation (ingestion only)
# Sonnet for reasoning and delivery (queries)
# Haiku for fast background tasks
GROKLY_ALIAS_QUALITY_MODEL=claude-opus-4-20250514
GROKLY_ALIAS_REASONING_MODEL=claude-sonnet-4-20250514
GROKLY_ALIAS_FAST_MODEL=claude-haiku-4-5-20251001
GROKLY_ALIAS_BALANCED_MODEL=claude-sonnet-4-20250514

# Use promoted knowledge base
GROKLY_KB_SOURCE=promoted
GROKLY_KB_PATH=./chroma_db_promoted

GROKLY_AUTH_REQUIRED=true
GROKLY_ALLOW_SELF_SELECTION=false

GROKLY_DEBUG=false
